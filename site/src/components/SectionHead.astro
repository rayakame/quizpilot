---
interface Props {
  eyebrow: string
  title: string
  text?: string
}

const { eyebrow, title, text } = Astro.props
---

<div data-reveal class="mx-auto max-w-3xl text-center">
  <span class="eyebrow">{eyebrow}</span>
  <h2 class="mt-5 font-display text-4xl leading-[1.02] font-bold tracking-[-0.035em] text-balance sm:text-6xl">
    {title}
  </h2>
  {text && <p class="mx-auto mt-5 max-w-2xl text-lg text-balance text-zinc-400">{text}</p>}
</div>
