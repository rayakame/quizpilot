---
import dashboard from "../assets/dashboard.png"
import { REPO } from "../lib/download"
import AppWindow from "./AppWindow.astro"
import Icon from "./Icon.astro"

const CHIPS = [
  { text: "Jev · 97% sure", class: "left-[-3%] top-[18%]", delay: "0s", dot: "bg-lime" },
  { text: "+950 points", class: "right-[-4%] top-[30%]", delay: "1.2s", dot: "bg-sun" },
  { text: "Answered in 0.8 s", class: "left-[2%] bottom-[14%]", delay: "2.1s", dot: "bg-emerald" },
  { text: "Backup AI · Claude", class: "right-[1%] bottom-[8%]", delay: "0.6s", dot: "bg-sky-400" },
]
---

<section class="relative px-4 pt-[clamp(6.5rem,16svh,11rem)]">
  <div class="mx-auto max-w-5xl text-center">
    <div data-reveal class="eyebrow">
      <span class="size-1.5 rounded-full bg-lime [animation:pulse-dot_2s_ease-in-out_infinite]"></span>
      Open source · macOS, Windows & Linux
    </div>
    <h1
      data-reveal
      style="--delay: 80ms"
      class="mt-7 font-display text-[clamp(2.75rem,min(10vw,14svh),8.5rem)] leading-[0.88] font-bold tracking-[-0.045em]"
    >
      Kahoot on
      <br />
      <span class="text-gradient">autopilot.</span>
    </h1>
    <p
      data-reveal
      style="--delay: 160ms"
      class="mx-auto mt-7 max-w-2xl text-lg text-balance text-zinc-400 sm:text-xl"
    >
      QuizPilot joins a game with up to five bots that answer for you with AI. You just watch the
      scoreboard.
    </p>
    <div
      data-reveal
      style="--delay: 240ms"
      class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row"
    >
      <a href="#download" data-primary class="btn-primary">
        <Icon name="download" />
        <span data-label>Download QuizPilot</span>
      </a>
      <a href={`https://github.com/${REPO}`} class="btn-ghost">
        Source on GitHub
        <Icon name="arrow" class="size-4" />
      </a>
    </div>
    <p class="mt-3 h-5 text-sm text-zinc-400">
      <span data-note hidden></span>
      <a
        data-alternative
        hidden
        class="ml-1 underline decoration-white/30 underline-offset-4 hover:text-white"
      ></a>
    </p>
    <p data-reveal style="--delay: 320ms" class="mt-3 text-sm text-zinc-400">
      <span data-version>Free</span> · MIT licensed · No account needed
    </p>
  </div>

  <div class="relative mx-auto mt-[clamp(3rem,8svh,5rem)] max-w-6xl">
    <div class="pointer-events-none absolute inset-x-0 -top-10 bottom-0 rounded-[3rem] bg-gradient-to-b from-lime/25 via-emerald/10 to-transparent blur-3xl"></div>
    <div class="tilt relative">
      <AppWindow src={dashboard} alt="QuizPilot answering a question during a game" eager />
    </div>
    {CHIPS.map((chip) => (
      <div
        class:list={[
          "glass float absolute hidden items-center gap-2 rounded-full px-4 py-2 text-sm font-medium shadow-xl shadow-black/50 xl:flex",
          chip.class,
        ]}
        style={`animation-delay: ${chip.delay}`}
      >
        <span class:list={["size-2 rounded-full", chip.dot]} />
        {chip.text}
      </div>
    ))}
  </div>
</section>
